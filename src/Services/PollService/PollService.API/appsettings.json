{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://vote-seq:5341"
        }
      }
    ],
    "Properties": {
      "ServiceName": "PollService"
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "Environment"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=PollDb;User Id=sa;Password=Password1234;TrustServerCertificate=True;"
  },
  "RabbitMq": {
    "Host": "amqp://localhost:5672",
    "Username": "n_user",
    "Password": "n_password"
  },
  "JWT": {
    "Issuer": "VoteSystem.AuthService",
    "Audience": "VoteSystem.Services",
    "ExpirationInDays": 7,
    "SecretKey": "SecretKey-ALAw5BGeS9dvCCYQJdreyiNm1IZfRT7ALK3VRu7TxXcOC5nSdBgBG1aZAdz6SBhu"
  },
  "AllowedHosts": "*"
}
